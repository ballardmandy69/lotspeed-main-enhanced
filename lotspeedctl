#!/usr/bin/env bash
# LotSpeed v3.10.8 enhanced management utility

set -Eeuo pipefail

VERSION="3.10.8-enhanced"
MODULE_NAME="lotspeed"
PARAM_DIR="/sys/module/${MODULE_NAME}/parameters"
SYSCTL_FILE="/etc/sysctl.d/99-lotspeed.conf"
MUX_SYSCTL_FILE="/etc/sysctl.d/99-lotspeed-mux-buffers.conf"
MODPROBE_FILE="/etc/modprobe.d/lotspeed.conf"
MODULE_FILE="/lib/modules/$(uname -r)/kernel/net/ipv4/extra/lotspeed.ko"
LEGACY_MODULE_FILE="/lib/modules/$(uname -r)/kernel/net/ipv4/lotspeed.ko"

green='\033[0;32m'
yellow='\033[1;33m'
red='\033[0;31m'
cyan='\033[0;36m'
reset='\033[0m'

info() { printf "${green}[INFO]${reset} %s\n" "$*"; }
warn() { printf "${yellow}[WARN]${reset} %s\n" "$*"; }
fail() { printf "${red}[ERROR]${reset} %s\n" "$*" >&2; exit 1; }

require_root() {
    [[ ${EUID} -eq 0 ]] || fail "This command must be run as root."
}

require_loaded() {
    [[ -d "${PARAM_DIR}" ]] || fail "LotSpeed is not loaded."
}

require_params() {
    local parameter

    for parameter in "$@"; do
        [[ -f "${PARAM_DIR}/${parameter}" ]] ||
            fail "Loaded LotSpeed module is missing ${parameter}. Re-run the latest installer before applying this preset."
    done
}

available_cc() {
    sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || true
}

fallback_cc() {
    local available
    available="$(available_cc)"
    for cc in cubic reno bbr; do
        if grep -qw "${cc}" <<<"${available}"; then
            printf '%s\n' "${cc}"
            return
        fi
    done
    awk '{print $1}' <<<"${available}"
}

write_param() {
    local name="$1"
    local value="$2"
    local path="${PARAM_DIR}/${name}"

    [[ -f "${path}" ]] || fail "Unknown parameter: ${name}"
    printf '%s\n' "${value}" > "${path}"
}

persist_params() {
    local name value line="options ${MODULE_NAME}"

    while IFS= read -r name; do
        value="$(<"${PARAM_DIR}/${name}")"
        line+=" ${name}=${value}"
    done < <(find "${PARAM_DIR}" -maxdepth 1 -type f -name 'lotserver_*' -printf '%f\n' | sort)

    printf '%s\n' "${line}" > "${MODPROBE_FILE}"
}

configure_mux_buffers() {
    cat > "${MUX_SYSCTL_FILE}" <<'EOF'
# LotSpeed throughput profile: bounded per-socket memory for many TCP clients.
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=8192 524288 16777216
net.ipv4.tcp_wmem=8192 524288 16777216
net.ipv4.tcp_notsent_lowat=262144
net.ipv4.tcp_limit_output_bytes=1048576
net.ipv4.tcp_moderate_rcvbuf=1
net.ipv4.tcp_window_scaling=1
EOF
    sysctl -p "${MUX_SYSCTL_FILE}" >/dev/null
}

set_param() {
    local name="${1:-}"
    local value="${2:-}"

    require_root
    require_loaded
    [[ -n "${name}" && -n "${value}" ]] ||
        fail "Usage: lotspeed set <parameter> <value>"
    [[ "${name}" =~ ^lotserver_[a-z0-9_]+$ ]] ||
        fail "Invalid parameter name."
    write_param "${name}" "${value}"
    persist_params
    info "${name}=$(<"${PARAM_DIR}/${name}")"
}

set_common_safety() {
    write_param lotserver_turbo 0
    write_param lotserver_pacing_gain 120
    write_param lotserver_probe_rtt_interval_ms 30000
    write_param lotserver_probe_rtt_duration_ms 150
    write_param lotserver_probe_rtt_cwnd_pct 50
    write_param lotserver_min_rtt_window_sec 10
    write_param lotserver_rtt_tolerance_pct 60
    write_param lotserver_min_flight_ms 0
    write_param lotserver_avoid_hold_ms 500
    write_param lotserver_loss_congest_pct 20
    write_param lotserver_loss_recover_pct 8
    write_param lotserver_loss_adapt_pct 8
    write_param lotserver_loss_adapt_samples 8
    write_param lotserver_rtt_confirm_samples 12
    write_param lotserver_loss_guard 1
    write_param lotserver_noncong_beta 972
    write_param lotserver_hd_enable 1
    write_param lotserver_hd_thresh_us 120000
    write_param lotserver_hd_gain_boost 20
}

apply_preset() {
    local preset="${1:-}"
    local enhanced_parameters=(
        lotserver_rate
        lotserver_min_rate_pct
        lotserver_gain
        lotserver_beta
        lotserver_min_cwnd
        lotserver_max_cwnd
        lotserver_adaptive
        lotserver_turbo
        lotserver_pacing_gain
        lotserver_probe_rtt_interval_ms
        lotserver_probe_rtt_duration_ms
        lotserver_probe_rtt_cwnd_pct
        lotserver_min_rtt_window_sec
        lotserver_rtt_tolerance_pct
        lotserver_min_flight_ms
        lotserver_avoid_hold_ms
        lotserver_loss_congest_pct
        lotserver_loss_recover_pct
        lotserver_loss_adapt_pct
        lotserver_loss_adapt_samples
        lotserver_rtt_confirm_samples
        lotserver_loss_guard
        lotserver_noncong_beta
        lotserver_hd_enable
        lotserver_hd_thresh_us
        lotserver_hd_gain_boost
    )

    require_root
    require_loaded
    require_params "${enhanced_parameters[@]}"

    case "${preset}" in
        domestic-mixed|domestic|mux-throughput|mux|wan-enhanced|main-guarded)
            # Mux profile with sustained moderate-loss adaptive control.
            write_param lotserver_rate 45000000
            write_param lotserver_min_rate_pct 50
            write_param lotserver_gain 26
            write_param lotserver_beta 871
            write_param lotserver_min_cwnd 32
            write_param lotserver_max_cwnd 10000
            write_param lotserver_adaptive 1
            set_common_safety
            write_param lotserver_pacing_gain 120
            write_param lotserver_probe_rtt_interval_ms 300000
            write_param lotserver_probe_rtt_duration_ms 100
            write_param lotserver_probe_rtt_cwnd_pct 75
            write_param lotserver_min_rtt_window_sec 30
            write_param lotserver_rtt_tolerance_pct 80
            write_param lotserver_min_flight_ms 250
            write_param lotserver_avoid_hold_ms 250
            write_param lotserver_loss_congest_pct 30
            write_param lotserver_loss_recover_pct 25
            write_param lotserver_loss_adapt_pct 3
            write_param lotserver_loss_adapt_samples 5
            write_param lotserver_rtt_confirm_samples 20
            write_param lotserver_noncong_beta 1000
            write_param lotserver_hd_enable 0
            configure_mux_buffers
            ;;
        ct-163-return|ct-return)
            # Overseas server to China Telecom over ordinary 163 routes.
            write_param lotserver_rate 31250000
            write_param lotserver_min_rate_pct 60
            write_param lotserver_gain 20
            write_param lotserver_beta 768
            write_param lotserver_min_cwnd 32
            write_param lotserver_max_cwnd 6000
            write_param lotserver_adaptive 1
            set_common_safety
            write_param lotserver_pacing_gain 100
            write_param lotserver_loss_guard 0
            write_param lotserver_hd_enable 0
            write_param lotserver_rtt_tolerance_pct 60
            write_param lotserver_loss_congest_pct 20
            write_param lotserver_loss_recover_pct 8
            write_param lotserver_rtt_confirm_samples 8
            write_param lotserver_avoid_hold_ms 1000
            write_param lotserver_min_rtt_window_sec 30
            write_param lotserver_probe_rtt_interval_ms 60000
            write_param lotserver_probe_rtt_duration_ms 100
            ;;
        conservative)
            write_param lotserver_rate 125000000
            write_param lotserver_min_rate_pct 75
            write_param lotserver_gain 15
            write_param lotserver_beta 717
            write_param lotserver_min_cwnd 16
            write_param lotserver_max_cwnd 2000
            write_param lotserver_adaptive 1
            set_common_safety
            ;;
        balanced)
            write_param lotserver_rate 625000000
            write_param lotserver_min_rate_pct 75
            write_param lotserver_gain 20
            write_param lotserver_beta 717
            write_param lotserver_min_cwnd 16
            write_param lotserver_max_cwnd 5000
            write_param lotserver_adaptive 1
            set_common_safety
            ;;
        aggressive)
            write_param lotserver_rate 1250000000
            write_param lotserver_min_rate_pct 75
            write_param lotserver_gain 30
            write_param lotserver_beta 819
            write_param lotserver_min_cwnd 32
            write_param lotserver_max_cwnd 8000
            write_param lotserver_adaptive 1
            set_common_safety
            ;;
        fixed-1g)
            write_param lotserver_rate 125000000
            write_param lotserver_min_rate_pct 100
            write_param lotserver_gain 30
            write_param lotserver_beta 820
            write_param lotserver_min_cwnd 32
            write_param lotserver_max_cwnd 15000
            write_param lotserver_adaptive 0
            set_common_safety
            ;;
        *)
            cat <<'EOF'
Available presets:
  mux-throughput - Sustained-loss Mux control, adaptive floor at 60%
  main-guarded   - Alias for mux-throughput
  domestic-mixed - Alias for mux-throughput
  ct-163-return - Overseas to China Telecom ordinary 163 route
  wan-enhanced  - Alias for mux-throughput
  conservative  - 1 Gbps ceiling, adaptive, low queue pressure
  balanced      - 5 Gbps ceiling, adaptive
  aggressive    - 10 Gbps ceiling, adaptive
  fixed-1g      - 1 Gbps fixed-rate, aggressive WAN profile
EOF
            exit 1
            ;;
    esac

    sysctl -w net.ipv4.tcp_no_metrics_save=1 >/dev/null
    if ! sysctl -w net.core.default_qdisc=fq >/dev/null; then
        warn "Could not select fq as the default qdisc; TCP internal pacing remains active."
    fi
    persist_params
    info "Applied ${preset} preset."
}

show_status() {
    local current available loaded_version name value

    current="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
    available="$(available_cc)"
    loaded_version="$(cat "/sys/module/${MODULE_NAME}/version" 2>/dev/null || true)"

    printf "${cyan}LotSpeed %s status${reset}\n" "${VERSION}"
    if [[ -d "${PARAM_DIR}" ]]; then
        printf 'Module: loaded (%s)\n' "${loaded_version:-version unknown}"
    else
        printf 'Module: not loaded\n'
    fi
    printf 'Active TCP CC: %s\n' "${current:-unknown}"
    printf 'Available TCP CC: %s\n' "${available:-unknown}"
    printf 'tcp_no_metrics_save: %s\n' \
        "$(sysctl -n net.ipv4.tcp_no_metrics_save 2>/dev/null || echo unknown)"
    printf 'default_qdisc: %s\n' \
        "$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)"
    printf 'core_rmem_max: %s\n' \
        "$(sysctl -n net.core.rmem_max 2>/dev/null || echo unknown)"
    printf 'core_wmem_max: %s\n' \
        "$(sysctl -n net.core.wmem_max 2>/dev/null || echo unknown)"
    printf 'tcp_rmem: %s\n' \
        "$(sysctl -n net.ipv4.tcp_rmem 2>/dev/null || echo unknown)"
    printf 'tcp_wmem: %s\n' \
        "$(sysctl -n net.ipv4.tcp_wmem 2>/dev/null || echo unknown)"
    printf 'tcp_notsent_lowat: %s\n' \
        "$(sysctl -n net.ipv4.tcp_notsent_lowat 2>/dev/null || echo unknown)"
    printf 'tcp_limit_output_bytes: %s\n' \
        "$(sysctl -n net.ipv4.tcp_limit_output_bytes 2>/dev/null || echo unknown)"

    [[ -d "${PARAM_DIR}" ]] || return
    printf '\nParameters:\n'
    while IFS= read -r name; do
        value="$(<"${PARAM_DIR}/${name}")"
        case "${name}" in
            lotserver_rate)
                printf '  %-32s %s bytes/s (%s Mbps)\n' \
                    "${name}" "${value}" "$((value * 8 / 1000000))"
                ;;
            lotserver_min_rate_pct)
                printf '  %-32s %s%% of rate\n' "${name}" "${value}"
                ;;
            lotserver_loss_adapt_samples|lotserver_rtt_confirm_samples)
                printf '  %-32s %s qualified rounds\n' "${name}" "${value}"
                ;;
            lotserver_gain)
                printf '  %-32s %s (%d.%dx cwnd gain)\n' \
                    "${name}" "${value}" "$((value / 10))" "$((value % 10))"
                ;;
            lotserver_beta|lotserver_noncong_beta)
                printf '  %-32s %s (%d%% retained)\n' \
                    "${name}" "${value}" "$((value * 100 / 1024))"
                ;;
            *)
                printf '  %-32s %s\n' "${name}" "${value}"
                ;;
        esac
    done < <(find "${PARAM_DIR}" -maxdepth 1 -type f -printf '%f\n' | sort)
}

show_rate_status() {
    local rate min_rate_pct pacing_gain jitter_gain
    local full_bps jitter_bps dynamic_min_bps dynamic_max_bps

    require_loaded
    command -v ss >/dev/null 2>&1 || fail "ss command not found."

    rate="$(<"${PARAM_DIR}/lotserver_rate")"
    min_rate_pct="$(<"${PARAM_DIR}/lotserver_min_rate_pct")"
    pacing_gain="$(<"${PARAM_DIR}/lotserver_pacing_gain")"
    full_bps=$((rate * pacing_gain * 8 / 100))
    jitter_gain="${pacing_gain}"
    if (( jitter_gain > 110 )); then
        jitter_gain=110
    fi
    jitter_bps=$((rate * jitter_gain * 8 / 100))
    dynamic_min_bps=$((rate * min_rate_pct * 8 / 100))
    dynamic_max_bps=$((rate * 8))

    printf "${cyan}LotSpeed adaptive rate summary${reset}\n"
    printf 'Current network namespace; established LotSpeed sockets only.\n'
    printf 'Expected rates: FULL_120=%s, JITTERY_110=%s, ADAPTIVE_100=%s-%s bps\n\n' \
        "${full_bps}" "${jitter_bps}" \
        "${dynamic_min_bps}" "${dynamic_max_bps}"

    LC_ALL=C ss -tinH state established | awk \
        -v full="${full_bps}" -v jitter="${jitter_bps}" \
        -v dynamic_min="${dynamic_min_bps}" \
        -v dynamic_max="${dynamic_max_bps}" '
        function rate_value(text, value, suffix) {
            sub(/bps$/, "", text)
            suffix = substr(text, length(text), 1)
            if (suffix == "K" || suffix == "k") {
                text = substr(text, 1, length(text) - 1)
                return text * 1000
            }
            if (suffix == "M" || suffix == "m") {
                text = substr(text, 1, length(text) - 1)
                return text * 1000000
            }
            if (suffix == "G" || suffix == "g") {
                text = substr(text, 1, length(text) - 1)
                return text * 1000000000
            }
            return text + 0
        }
        function close_to(value, target) {
            return target > 0 && value >= target * 0.995 &&
                   value <= target * 1.005
        }
        /lotspeed/ {
            pacing = 0
            lastsnd = -1
            for (i = 1; i <= NF; i++) {
                if ($i == "pacing_rate" && i < NF) {
                    pacing = rate_value($(i + 1))
                } else if ($i ~ /^lastsnd:[0-9]+$/) {
                    split($i, item, ":")
                    lastsnd = item[2] + 0
                }
            }

            total++
            active = lastsnd >= 0 && lastsnd <= 10000
            if (!active) {
                idle_count++
                if (pacing >= dynamic_min * 0.995 &&
                    pacing <= dynamic_max * 1.005)
                    idle_dynamic_count++
                next
            }

            if (close_to(pacing, full))
                active_full_count++
            else if (close_to(pacing, jitter))
                active_jitter_count++
            else if (pacing >= dynamic_min * 0.995 &&
                     pacing <= dynamic_max * 1.005)
                active_dynamic_count++
            else
                active_other_count++
        }
        END {
            printf "  %-24s %u\n", "ACTIVE_FULL_120", active_full_count + 0
            printf "  %-24s %u\n", "ACTIVE_JITTERY_110", active_jitter_count + 0
            printf "  %-24s %u\n", "ACTIVE_ADAPTIVE_100", active_dynamic_count + 0
            printf "  %-24s %u\n", "ACTIVE_OTHER", active_other_count + 0
            printf "  %-24s %u\n", "IDLE_OR_STALLED", idle_count + 0
            printf "  %-24s %u\n", "IDLE_ADAPTIVE_STALE", idle_dynamic_count + 0
            printf "  %-24s %u\n", "TOTAL", total + 0
        }'
}

start_module() {
    require_root
    if ! lsmod | awk '{print $1}' | grep -qx "${MODULE_NAME}"; then
        modprobe "${MODULE_NAME}"
    fi
    sysctl -w net.ipv4.tcp_congestion_control=lotspeed >/dev/null
    sysctl -w net.ipv4.tcp_no_metrics_save=1 >/dev/null
    if ! sysctl -w net.core.default_qdisc=fq >/dev/null; then
        warn "Could not select fq as the default qdisc; TCP internal pacing remains active."
    fi
    info "LotSpeed is active."
}

stop_module() {
    local fallback

    require_root
    fallback="$(fallback_cc)"
    [[ -n "${fallback}" ]] ||
        fail "No fallback TCP congestion control is available."
    sysctl -w "net.ipv4.tcp_congestion_control=${fallback}" >/dev/null

    if lsmod | awk '{print $1}' | grep -qx "${MODULE_NAME}"; then
        if rmmod "${MODULE_NAME}"; then
            info "LotSpeed stopped; active TCP CC is ${fallback}."
        else
            warn "Default CC changed to ${fallback}, but existing sockets still reference LotSpeed."
        fi
    else
        info "LotSpeed is already stopped."
    fi
}

restart_module() {
    require_root
    stop_module
    if lsmod | awk '{print $1}' | grep -qx "${MODULE_NAME}"; then
        fail "Cannot restart while existing sockets reference LotSpeed."
    fi
    start_module
}

show_logs() {
    dmesg | grep -i lotspeed | tail -n "${1:-50}"
}

uninstall_module() {
    local fallback

    require_root
    fallback="$(fallback_cc)"
    [[ -n "${fallback}" ]] && sysctl -w "net.ipv4.tcp_congestion_control=${fallback}" >/dev/null

    if lsmod | awk '{print $1}' | grep -qx "${MODULE_NAME}"; then
        rmmod "${MODULE_NAME}" ||
            fail "Existing sockets still reference LotSpeed. Close them before uninstalling."
    fi

    rm -f /etc/modules-load.d/lotspeed.conf "${SYSCTL_FILE}" \
        "${MUX_SYSCTL_FILE}" \
        "${MODPROBE_FILE}" "${MODULE_FILE}" "${MODULE_FILE}.xz" \
        "${MODULE_FILE}.zst" "${MODULE_FILE}.gz" "${LEGACY_MODULE_FILE}" \
        "${LEGACY_MODULE_FILE}.xz" "${LEGACY_MODULE_FILE}.zst" \
        "${LEGACY_MODULE_FILE}.gz"
    rm -rf /opt/lotspeed
    depmod -a
    rm -f /usr/local/bin/lotspeed
    info "LotSpeed uninstalled."
}

show_help() {
    cat <<'EOF'
Usage: lotspeed <command> [arguments]

Commands:
  status                         Show module and parameter status
  rate-status                    Count sockets by adaptive pacing rate
  guard-status                   Compatibility alias for rate-status
  preset <name>                  Apply a tested parameter profile
  set <parameter> <value>        Change one module parameter
  start                          Load and activate LotSpeed
  stop                           Switch away and unload when possible
  restart                        Reload and activate LotSpeed
  logs [count]                   Show recent kernel log entries
  uninstall                      Remove LotSpeed from this kernel
  help                           Show this help
EOF
}

case "${1:-help}" in
    status) show_status ;;
    rate-status|guard-status) show_rate_status ;;
    preset) apply_preset "${2:-}" ;;
    set) set_param "${2:-}" "${3:-}" ;;
    start) start_module ;;
    stop) stop_module ;;
    restart) restart_module ;;
    logs) show_logs "${2:-50}" ;;
    uninstall) uninstall_module ;;
    help|-h|--help) show_help ;;
    *) fail "Unknown command: $1. Run 'lotspeed help'." ;;
esac
